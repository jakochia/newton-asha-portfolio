            </div>

            <!-- Hire Me CTA (>= 768px) -->
            <a href="#contact" class="hidden md:inline-flex items-center gap-2 bg-slate-900 hover:bg-blue-700 text-white text-sm font-medium px-3 lg:px-4 py-2 rounded-lg transition-colors shadow-sm flex-shrink-0">
                Hire Me <i class="fas fa-arrow-right text-xs"></i>
