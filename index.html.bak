<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Newton Asha Ombuya — ICT Support, Networking & Software Engineering. Cisco Networking Academy Instructor based in Nairobi, Kenya.">
    <meta name="author" content="Newton Asha Ombuya">
    <meta name="theme-color" content="#0f172a">
    <title>Newton Asha — ICT Support · Networking · Software Engineering</title>

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%237dd3a8'/%3E%3Cstop offset='0.5' stop-color='%23b8e6c9'/%3E%3Cstop offset='1' stop-color='%23f0f9f4'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='512' height='512' fill='url(%23g)'/%3E%3Ctext x='50%25' y='54%25' font-family='Inter,Helvetica,Arial,sans-serif' font-size='180' font-weight='800' fill='%231f2937' text-anchor='middle' dominant-baseline='middle' letter-spacing='-6'%3EASHA%3C/text%3E%3C/svg%3E">
    <link rel="apple-touch-icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 512 512'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%237dd3a8'/%3E%3Cstop offset='0.5' stop-color='%23b8e6c9'/%3E%3Cstop offset='1' stop-color='%23f0f9f4'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='512' height='512' fill='url(%23g)'/%3E%3Ctext x='50%25' y='54%25' font-family='Inter,Helvetica,Arial,sans-serif' font-size='180' font-weight='800' fill='%231f2937' text-anchor='middle' dominant-baseline='middle' letter-spacing='-6'%3EASHA%3C/text%3E%3C/svg%3E">

    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'system-ui', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50:  '#eff6ff',
                            100: '#dbeafe',
                            500: '#3b82f6',
                            600: '#2563eb',
                            700: '#1d4ed8',
                            900: '#1e3a8a',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        * { -webkit-font-smoothing: antialiased; -moz-osx-font-smoothing: grayscale; }
        html { scroll-behavior: smooth; }
        body { font-family: 'Inter', sans-serif; }

        .nav-link { position: relative; }
        .nav-link.active { color: #2563eb; font-weight: 600; }
        .nav-link.active::after {
            content: '';
            position: absolute;
            bottom: -6px;
            left: 50%;
            transform: translateX(-50%);
            width: 24px;
            height: 2px;
            background: #2563eb;
            border-radius: 2px;
        }
        .mobile-nav-link.active {
            color: #2563eb;
            font-weight: 600;
            background: #eff6ff;
            border-radius: 8px;
        }

        .reveal { opacity: 0; transform: translateY(24px); transition: opacity 0.8s ease, transform 0.8s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        .card { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .card:hover {
            transform: translateY(-4px);
            box-shadow: 0 20px 30px -12px rgba(0, 0, 0, 0.1);
        }

        .profile-pic {
            transition: transform 0.5s ease;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid white;
            box-shadow: 0 20px 40px rgba(37, 99, 235, 0.12);
        }
        .profile-pic:hover { transform: scale(1.03); }

        .accent-gradient {
            background: linear-gradient(135deg, #2563eb 0%, #3b82f6 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .loading {
            display: inline-block;
            width: 18px; height: 18px;
            border: 3px solid rgba(255,255,255,.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 0.8s linear infinite;
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        .blog-gradient {
            background: linear-gradient(145deg, #0f172a 0%, #1e293b 100%);
        }

        .hidden { display: none !important; }

        .verified-tick {
            display: inline-block;
            vertical-align: middle;
            flex-shrink: 0;
        }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 antialiased">

