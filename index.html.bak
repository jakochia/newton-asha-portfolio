                    <div class="pt-4">
                        <p class="text-xs text-slate-500 uppercase tracking-wide mb-3">Follow Me</p>
                        <div class="flex gap-3">
                            <a href="https://twitter.com/j_kochia" target="_blank" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-blue-500 hover:text-white text-slate-600 flex items-center justify-center transition-colors">
                                <i class="fab fa-twitter"></i>
                            </a>
                            <a href="https://www.instagram.com/la.flame.drone" target="_blank" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-pink-500 hover:text-white text-slate-600 flex items-center justify-center transition-colors">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="https://github.com/jakochia" target="_blank" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-slate-900 hover:text-white text-slate-600 flex items-center justify-center transition-colors">
                                <i class="fab fa-github"></i>
                            </a>
                            <a href="https://www.linkedin.com/in/newton-ombuya-776566356" target="_blank" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-blue-600 hover:text-white text-slate-600 flex items-center justify-center transition-colors">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="https://blog.jakochia.co.ke" target="_blank" class="w-10 h-10 rounded-xl bg-slate-100 hover:bg-indigo-600 hover:text-white text-slate-600 flex items-center justify-center transition-colors">
                                <i class="fas fa-blog"></i>
