            <!-- Hamburger (visible < 768px) -->
            <button id="mobile-menu-button" class="md:hidden text-slate-700 text-2xl flex-shrink-0" aria-label="Toggle menu">
                <i class="fas fa-bars"></i>
            </button>
        </div>

        <!-- Mobile menu (< 768px) -->
        <div id="mobile-menu" class="md:hidden hidden bg-white border-t border-slate-200 py-4 px-6">
