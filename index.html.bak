    <!-- ═══════════ HERO ═══════════ -->
    <section id="home" class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden bg-gradient-to-b from-slate-50 via-white to-slate-50">
        <div class="absolute inset-0 -z-10 pointer-events-none">
            <div class="absolute top-20 -left-20 w-96 h-96 rounded-full bg-blue-100/60 blur-3xl"></div>
            <div class="absolute top-40 right-0 w-96 h-96 rounded-full bg-slate-200/50 blur-3xl"></div>
        </div>

        <div class="max-w-7xl mx-auto px-6 grid lg:grid-cols-12 gap-12 items-center">
            <div class="lg:col-span-7 space-y-8">
                <div class="inline-flex items-center gap-2 bg-blue-50 border border-blue-100 text-blue-700 text-xs font-medium px-3 py-1.5 rounded-full">
                    <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
                    Available for opportunities
                </div>

                <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-slate-900 leading-[1.1] tracking-tight">
                    Hi, I'm <span class="accent-gradient">Newton Asha Ombuya</span><span class="inline-flex items-center align-middle ml-2"><svg viewBox="0 0 24 24" class="w-8 h-8 sm:w-9 sm:h-9 lg:w-11 lg:h-11" fill="#1d9bf0" xmlns="http://www.w3.org/2000/svg"><path d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81C14.67 2.63 13.43 1.75 12 1.75s-2.67.88-3.34 2.19c-1.39-.46-2.9-.2-3.91.81s-1.27 2.52-.81 3.91C2.63 9.33 1.75 10.57 1.75 12s.88 2.67 2.19 3.34c-.46 1.39-.2 2.9.81 3.91s2.52 1.27 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.67-.88 3.34-2.19c1.39.46 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34zm-11.71 4.2L6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z"/></svg></span>.
                </h1>

                <div class="flex flex-wrap items-center gap-3 text-slate-700 font-medium">
                    <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-sm shadow-sm">ICT Support</span>
                    <span class="text-slate-300">•</span>
                    <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-sm shadow-sm">Networking</span>
                    <span class="text-slate-300">•</span>
                    <span class="bg-white border border-slate-200 px-3 py-1.5 rounded-lg text-sm shadow-sm">Software Engineering</span>
                </div>

                <p class="text-lg text-slate-600 max-w-xl leading-relaxed">
                    Cisco Networking Academy Instructor with hands-on experience in ICT user support, Cisco device configuration, network troubleshooting, and software development. Currently pursuing diplomas at <strong class="text-slate-900">ICS College</strong> and <strong class="text-slate-900">MOHI TTI</strong>.
                </p>

                <div class="flex flex-wrap gap-4 pt-2">
                    <a href="#projects" class="inline-flex items-center gap-2 bg-slate-900 hover:bg-blue-700 text-white font-medium px-6 py-3 rounded-xl transition-all shadow-lg shadow-slate-900/10 hover:shadow-blue-600/20">
                        <i class="fas fa-folder-open"></i> View Projects
                    </a>
                    <a href="https://blog.jakochia.co.ke" target="_blank" class="inline-flex items-center gap-2 bg-white hover:bg-blue-50 border border-slate-200 hover:border-blue-300 text-slate-900 font-medium px-6 py-3 rounded-xl transition-all">
                        <i class="fas fa-blog text-blue-600"></i> Read Blog
                    </a>
                    <a href="#cv" class="inline-flex items-center gap-2 bg-green-50 hover:bg-green-100 border border-green-200 text-green-700 font-medium px-6 py-3 rounded-xl transition-all">
                        <i class="fas fa-download"></i> Download CV
                    </a>
                </div>
            </div>

            <div class="lg:col-span-5 flex justify-center lg:justify-end">
                <div class="relative">
                    <div class="absolute inset-0 rounded-full bg-gradient-to-br from-blue-400 to-blue-600 blur-2xl opacity-20"></div>
                    <img src="asha.jpg" alt="Newton Asha" class="profile-pic relative w-64 h-64 lg:w-80 lg:h-80">
                    <div class="absolute -bottom-2 -right-2 bg-white rounded-2xl shadow-xl p-3 border border-slate-100">
                        <div class="flex items-center gap-2">
                            <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center">
                                <i class="fas fa-network-wired text-blue-600 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-[10px] text-slate-500 uppercase tracking-wide">Cisco Academy</p>
                                <p class="text-xs font-bold text-slate-900">Instructor</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-6 mt-20">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
                    <p class="text-3xl font-extrabold text-slate-900">10+</p>
                    <p class="text-sm text-slate-500 mt-1">Certifications</p>
